# ==========================================
# OTMS AI Observability Service
# ==========================================

# Application
APP_NAME=OTMS AI Observability Service
APP_VERSION=1.0.0
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# API
API_PREFIX=/api/v1


# ==========================================
# Ollama
# ==========================================

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=300


# ==========================================
# Prometheus
# ==========================================

PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_TIMEOUT=30


# ==========================================
# Tempo
# ==========================================

TEMPO_URL=http://tempo:3200


# ==========================================
# Loki
# ==========================================

LOKI_URL=http://loki:3100
LOKI_TIMEOUT=30